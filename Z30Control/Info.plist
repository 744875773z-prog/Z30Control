<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>Z30 影控</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.nikonpro.z30control</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.6</string>
    <key>CFBundleVersion</key>
    <string>7</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    
    <!-- 彻底解决 iPhone 16 Pro Max / 灵动岛全尺寸全屏无黑边的金标准配置 -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    
    <!-- 外接数码相机硬件访问 (像素蛋糕同款 ImageCaptureCore 必需) -->
    <key>NSCameraUsageDescription</key>
    <string>Z30 影控需要访问外接数码相机设备，以通过 USB-C 数据线直接连接您的尼康相机，实现免配置秒连与即拍即传。</string>
    
    <!-- 本地局域网权限 (必须声明，支持 USB-C 虚拟以太网网卡与 Wi-Fi 15740 端口) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Z30 影控需要访问本地网络，以通过 USB-C 有线数据线或 Wi-Fi 建立与尼康相机的高速通信信道，用于低延迟实时取景、机身参数控制与照片传输。</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_ptp._tcp</string>
        <string>_ptp-ip._tcp</string>
    </array>
    
    <!-- 系统相册读取与保存权限 -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>需要相册保存权限，以便将从 Z30 相机下载的原片或胶片滤镜成片存入手机相册。</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>需要访问相册，以显示与管理您已从相机导入的照片。</string>
    
    <!-- 蓝牙权限 (用于辅助唤醒相机) -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>用于搜索并唤醒身边的尼康微单相机。</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>用于连接尼康相机的低功耗蓝牙信道。</string>
    
    <!-- 后台下载传输模式 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>
    
    <!-- 屏幕全方向自适应旋转 (支持专业横屏电影监视器与竖屏单手操控) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    
    <!-- 浅色工业级明亮外观 -->
    <key>UIUserInterfaceStyle</key>
    <string>Light</string>
</dict>
</plist>
